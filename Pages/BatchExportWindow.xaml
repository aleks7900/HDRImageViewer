<Window
    x:Class="HdrImageViewer.Pages.BatchExportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:HdrImageViewer.Services"
    Title="批量导出">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TitleBar x:Name="BatchTitleBar" Title="批量导出" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
            <Grid Padding="24" RowSpacing="20">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="待导出图片" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="FileCountText" Text="尚未添加图片" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="AddFilesButton" Click="AddFiles_Click" ToolTipService.ToolTip="添加图片" AutomationProperties.Name="添加图片">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="12" /><TextBlock Text="添加" /></StackPanel>
                        </Button>
                        <Button x:Name="RemoveButton" Click="Remove_Click" ToolTipService.ToolTip="移除选中项" AutomationProperties.Name="移除选中项" Width="32" Padding="0"><FontIcon Glyph="&#xE74D;" FontSize="14" /></Button>
                        <Button x:Name="ClearButton" Click="Clear_Click" ToolTipService.ToolTip="清空队列" AutomationProperties.Name="清空队列" Width="32" Padding="0"><FontIcon Glyph="&#xE894;" FontSize="14" /></Button>
                    </StackPanel>
                </Grid>
                <ListView x:Name="QueueList" Grid.Row="1" SelectionMode="Extended" AutomationProperties.Name="导出队列">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="8" /></Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="services:BatchExportItem">
                            <Grid ColumnSpacing="12" Padding="0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="40" Height="44" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="{StaticResource ControlCornerRadius}">
                                    <FontIcon Glyph="&#xEB9F;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind FileName}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Detail, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Detail, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind StateLabel, Mode=OneWay}" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="QueueEmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" IsHitTestVisible="False">
                    <FontIcon Glyph="&#xEB9F;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="从几张图片开始" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="点击添加，可一次选择多张图片" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Grid>
            <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="24">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="24">
                        <TextBlock Text="导出设置" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ComboBox x:Name="FormatSelector" Header="格式" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="Format_SelectionChanged">
                            <ComboBoxItem Content="PNG · SDR" /><ComboBoxItem Content="JPEG · SDR" />
                            <ComboBoxItem Content="JPEG · Ultra HDR" /><ComboBoxItem Content="PNG · HDR PQ" />
                            <ComboBoxItem Content="PNG · HDR HLG" /><ComboBoxItem Content="TIFF · 浮点 HDR" />
                            <ComboBoxItem Content="OpenEXR" /><ComboBoxItem Content="保留原格式" />
                            <ComboBoxItem Content="HEIC · Gain Map" /><ComboBoxItem Content="AVIF · Gain Map" />
                        </ComboBox>
                        <TextBlock x:Name="FormatNoteText" Text="适合分享。HDR 将转换为 SDR。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                        <StackPanel Spacing="8">
                            <TextBlock Text="保存到" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Button x:Name="FolderButton" Click="Folder_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                                    <TextBlock x:Name="FolderText" Grid.Column="1" Text="选择文件夹" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Button>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="文件命名" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="原文件名-export" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="重名时自动编号，不覆盖原图。" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Content="导出说明" Background="Transparent" BorderThickness="0" Padding="0" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Left">
                            <Button.Flyout><Flyout><TextBlock MaxWidth="280" TextWrapping="Wrap" Text="任务逐张执行，失败后继续。关闭窗口会取消剩余任务。SDR 使用固定色调映射，不跟随查看器曝光，也不保留 EXIF 和动态片段。" /></Flyout></Button.Flyout>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="24,16">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ProgressBar x:Name="QueueProgress" Minimum="0" Maximum="1" Visibility="Collapsed" />
                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="SummaryText" Text="准备就绪" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="RetryButton" Content="重试未完成" Click="Retry_Click" Visibility="Collapsed" />
                        <Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" Visibility="Collapsed" />
                        <Button x:Name="StartButton" Content="开始导出" Click="Start_Click" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" MinWidth="112" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
