                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource OverlayCornerRadius}">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="PhotoToolbarOverlayTransform" Y="0" />
                    </Border.RenderTransform>
                    <Grid
                        HorizontalAlignment="Center"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            AutomationProperties.AutomationId="OpenImageButton"
                            AutomationProperties.Name="打开图片"
                            Click="OpenImage_Click"
                            Style="{StaticResource PhotoToolbarButtonStyle}"
                            ToolTipService.ToolTip="打开">
                            <SymbolIcon Symbol="OpenFile" />
                        </Button>
                        <Button
                            x:Name="ReloadImageButton"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="ReloadImageButton"
                            AutomationProperties.Name="重新载入图片"
                            Click="ReloadImage_Click"
                            IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}"
                            Style="{StaticResource PhotoToolbarButtonStyle}"
                            ToolTipService.ToolTip="重新载入">
                            <SymbolIcon Symbol="Refresh" />
                        </Button>
                        <Border
                            Grid.Column="2"
                            Width="1"
                            Margin="0,8"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Button
                            x:Name="PreviousImageButton"
                            Grid.Column="3"
                            AutomationProperties.AutomationId="PreviousImageButton"
                            AutomationProperties.Name="上一张"
                            Click="PreviousImage_Click"
                            Style="{StaticResource PhotoToolbarButtonStyle}"
                            ToolTipService.ToolTip="上一张">
                            <FontIcon
                                FontSize="16"
                                Glyph="&#xE76B;" />
                        </Button>
                        <TextBlock
                            x:Name="FolderPositionText"
                            Grid.Column="4"
                            MinWidth="38"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="0 / 0"
                            TextAlignment="Center" />
                        <Grid
                            x:Name="FilmstripRow"
                            Grid.Column="5"
                            Height="46"
                            MinWidth="0"
                            HorizontalAlignment="Stretch"
                            Visibility="Collapsed">
                            <ListView
                                x:Name="ImageFilmstrip"
                                Height="46"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="ImageFilmstrip"
                                AutomationProperties.Name="同文件夹图片胶片条"
                                Background="Transparent"
                                BorderThickness="0"
                                IsItemClickEnabled="True"
                                ItemClick="ImageFilmstrip_ItemClick"
                                ItemContainerStyle="{StaticResource FilmstripListViewItemStyle}"
                                ItemsSource="{x:Bind FilmstripItems, Mode=OneWay}"
                                SelectionMode="Single"
                                ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                ScrollViewer.HorizontalScrollMode="Enabled"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollMode="Disabled">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsStackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="presentation:FilmstripImageItem">
                                        <Grid
                                            Width="60"
                                            Height="42"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="{x:Bind FileName}">
                                            <Border
                                                Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                BorderThickness="2"
                                                CornerRadius="{StaticResource OverlayCornerRadius}"
                                                IsHitTestVisible="False"
                                                Visibility="{x:Bind local:HomePage.BoolToVisibility(IsCurrent), Mode=OneWay}" />
                                            <Border
                                                Margin="4"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource ControlCornerRadius}">
                                                <Grid>
                                                    <FontIcon
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Glyph="&#xEB9F;" />
                                                    <Image
                                                        AutomationProperties.Name="{x:Bind FileName}"
                                                        Source="{x:Bind Thumbnail, Mode=OneWay}"
                                                        Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                        <TextBlock
                            x:Name="FolderFileNameText"
                            Grid.Column="5"
                            MinWidth="220"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.FileName, Mode=OneWay}"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                        <Button
                            x:Name="NextImageButton"
                            Grid.Column="6"
                            AutomationProperties.AutomationId="NextImageButton"
                            AutomationProperties.Name="下一张"
                            Click="NextImage_Click"
                            Style="{StaticResource PhotoToolbarButtonStyle}"
                            ToolTipService.ToolTip="下一张">
                            <FontIcon
                                FontSize="16"
                                Glyph="&#xE76C;" />
                        </Button>
                        <Border
                            Grid.Column="7"
                            Width="1"
                            Margin="0,8"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Button
                            x:Name="CropButton"
                            Grid.Column="8"
                            AutomationProperties.AutomationId="CropButton"
                            AutomationProperties.Name="裁切"
                            Click="CropButton_Click"
                            Style="{StaticResource PhotoToolbarButtonStyle}"
                            ToolTipService.ToolTip="裁切">
                            <FontIcon
                                FontSize="16"
                                Glyph="&#xE7A8;" />
                        </Button>
                        <Button
                            x:Name="SingleLayerHdrSaveAsButton"
                            Grid.Column="9"
                            AutomationProperties.AutomationId="SingleLayerHdrSaveAsButton"
                            AutomationProperties.Name="单层 HDR 另存为"
                            Click="SingleLayerHdrSaveAs_Click"
                            IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}"
                            Style="{StaticResource PhotoToolbarButtonStyle}"
                            ToolTipService.ToolTip="另存为单层 HDR">
                            <SymbolIcon Symbol="Save" />
                        </Button>
                        <Button
                            x:Name="ZoomOutButton"
                            Grid.Column="10"
                            AutomationProperties.AutomationId="ZoomOutButton"
                            AutomationProperties.Name="缩小"
                            Click="ZoomOut_Click"
                            Style="{StaticResource PhotoToolbarButtonStyle}"
                            ToolTipService.ToolTip="缩小">
                            <FontIcon
                                FontSize="16"
                                Glyph="&#xE71F;" />
                        </Button>
                        <TextBlock
                            x:Name="ZoomLevelText"
                            Grid.Column="11"
                            MinWidth="54"
                            HorizontalAlignment="Center"
                            Text="适合"
                            TextAlignment="Center"
                            VerticalAlignment="Center" />
                        <Button
                            x:Name="ZoomInButton"
                            Grid.Column="12"
                            AutomationProperties.AutomationId="ZoomInButton"
                            AutomationProperties.Name="放大"
                            Click="ZoomIn_Click"
                            Style="{StaticResource PhotoToolbarButtonStyle}"
                            ToolTipService.ToolTip="放大">
                            <FontIcon
                                FontSize="16"
                                Glyph="&#xE8A3;" />
                        </Button>
                        <Button
                            x:Name="ActualSizeButton"
                            Grid.Column="13"
                            AutomationProperties.AutomationId="ActualSizeButton"
                            AutomationProperties.Name="实际大小"
                            Click="ActualSize_Click"
                            Style="{StaticResource PhotoToolbarButtonStyle}"
                            ToolTipService.ToolTip="实际大小">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="1:1" />
                        </Button>
                        <Button
                            x:Name="ZoomFitButton"
                            Grid.Column="14"
                            AutomationProperties.AutomationId="ZoomFitButton"
                            AutomationProperties.Name="适合窗口"
                            Click="ZoomFit_Click"
                            Style="{StaticResource PhotoToolbarButtonStyle}"
                            ToolTipService.ToolTip="适合窗口">
                            <FontIcon
                                FontSize="16"
                                Glyph="&#xE9A6;" />
                        </Button>
                        <Button
                            x:Name="FullScreenButton"
                            Grid.Column="15"
                            AutomationProperties.AutomationId="FullScreenButton"
                            AutomationProperties.Name="全屏"
                            Click="FullScreen_Click"
                            Visibility="Collapsed"
                            Style="{StaticResource PhotoToolbarButtonStyle}"
                            ToolTipService.ToolTip="全屏">
                            <FontIcon
                                x:Name="FullScreenIcon"
                                FontSize="16"
                                Glyph="&#xE740;" />
                        </Button>
                        <Button
                            x:Name="ZoomFillButton"
                            Grid.Column="16"
                            AutomationProperties.AutomationId="ZoomFillButton"
                            AutomationProperties.Name="填满画布"
                            Click="ZoomFill_Click"
                            Style="{StaticResource PhotoToolbarButtonStyle}"
                            ToolTipService.ToolTip="填满画布">
                            <FontIcon
                                FontSize="16"
                                Glyph="&#xE9A7;" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <Border
                x:Name="InspectorPanel"
                Grid.Column="1"
                Margin="12,12,16,12"
                Padding="16"
                Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                BackgroundSizing="InnerBorderEdge"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="InspectorPanelTransform" />
                </Border.RenderTransform>
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <SelectorBar x:Name="InspectorSectionSelector" SelectionChanged="InspectorSection_SelectionChanged">
                        <SelectorBarItem x:Name="InspectorDetailsTab" Text="详情" IsSelected="True" />
                        <SelectorBarItem x:Name="InspectorAnalysisTab" Text="分析" />
                        <SelectorBarItem x:Name="InspectorGamutTab" Text="色域" />
                    </SelectorBar>
                <ScrollViewer Grid.Row="1"
                    x:Name="InspectorScroll"
                    AutomationProperties.Name="图片详情"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Enabled">
                <StackPanel
                    Margin="0,0,24,4"
                    Spacing="12">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="详情" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.FormatName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Text="{x:Bind ViewModel.HdrKind, Mode=OneWay}"
                            VerticalAlignment="Center" />
                    </Grid>

                    <Expander
                        Header="文件"
                        HorizontalAlignment="Stretch"
                        IsExpanded="True">
                        <StackPanel Spacing="12">
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.FileName, Mode=OneWay}"
                                TextWrapping="WrapWholeWords" />
                            <Grid ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource InspectorLabelTextStyle}" Text="格式" />
                                <TextBlock Grid.Column="1" Style="{StaticResource InspectorValueTextStyle}" Text="{x:Bind ViewModel.FormatName, Mode=OneWay}" />
                                <TextBlock Grid.Row="1" Style="{StaticResource InspectorLabelTextStyle}" Text="解码" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource InspectorValueTextStyle}" Text="{x:Bind ViewModel.Decoder, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <Expander
                        Header="EXIF"
                        HorizontalAlignment="Stretch"
                        IsExpanded="False">
                        <TextBlock
                            Style="{StaticResource InspectorValueTextStyle}"
                            Text="{x:Bind ViewModel.ExifSummary, Mode=OneWay}" />
                    </Expander>

                    <Expander
                        Header="HDR"
                        HorizontalAlignment="Stretch"
                        IsExpanded="True">
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource InspectorLabelTextStyle}" Text="类型" />
                            <TextBlock Grid.Column="1" Style="{StaticResource InspectorValueTextStyle}" Text="{x:Bind ViewModel.HdrKind, Mode=OneWay}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource InspectorLabelTextStyle}" Text="曲线" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource InspectorValueTextStyle}" Text="{x:Bind ViewModel.TransferFunction, Mode=OneWay}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource InspectorLabelTextStyle}" Text="色彩" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource InspectorValueTextStyle}" Text="{x:Bind ViewModel.ColorContainer, Mode=OneWay}" />
                        </Grid>
                    </Expander>

                    <Expander
                        Header="显示模式"
                        HorizontalAlignment="Stretch"
                        IsExpanded="True">
                        <StackPanel Spacing="12">
                            <ComboBox
                                x:Name="HdrPreviewModeSelector"
                                AutomationProperties.AutomationId="HdrPreviewModeSelector"
                                AutomationProperties.Name="HDR 显示模式"
                                HorizontalAlignment="Stretch"
                                SelectedIndex="1"
                                SelectionChanged="HdrPreviewModeSelector_SelectionChanged">
                                <ComboBoxItem Content="SDR" />
                                <ComboBoxItem Content="Adaptive" />
                                <ComboBoxItem Content="Alternate Image" />
                                <ComboBoxItem Content="Gain Map" />
                            </ComboBox>
                            <Grid
                                x:Name="SdrWhitePanel"
                                ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleSwitch
                                    x:Name="SdrWhiteOverrideToggle"
                                    AutomationProperties.AutomationId="SdrWhiteOverrideToggle"
                                    AutomationProperties.Name="自定义参考白亮度"
                                    Header="自定义参考白亮度"
                                    ToolTipService.ToolTip="参考白 = 内容漫反射白的目标亮度。203 nits = 绝对显示（与系统相册一致）；调低整体压暗，调高提亮。作用于单层 HDR（PQ/HLG）和 gain-map HDR。"
                                    IsOn="False"
                                    Toggled="SdrWhiteOverrideToggle_Toggled" />
                                <TextBlock
                                    x:Name="SdrWhiteValueText"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="绝对 203 nits" />
                            </Grid>
                            <Slider
                                x:Name="SdrWhiteSlider"
                                AutomationProperties.AutomationId="SdrWhiteSlider"
                                AutomationProperties.Name="自定义参考白亮度"
                                HorizontalAlignment="Stretch"
                                IsEnabled="False"
                                LargeChange="10"
                                Maximum="600"
                                Minimum="80"
                                SmallChange="1"
                                StepFrequency="1"
                                Value="203"
                                ValueChanged="SdrWhiteSlider_ValueChanged"
                                Visibility="Collapsed" />
                            <ComboBox
                                x:Name="HdrHeadroomModeSelector"
                                AutomationProperties.AutomationId="HdrHeadroomModeSelector"
                                AutomationProperties.Name="HDR Headroom 来源"
                                HorizontalAlignment="Stretch"
                                SelectedIndex="0"
                                SelectionChanged="HdrHeadroomModeSelector_SelectionChanged">
                                <ComboBoxItem Content="System Auto" />
                                <ComboBoxItem Content="Manual Override" />
                                <ComboBoxItem Content="ABL Simulation" IsEnabled="False" />
                            </ComboBox>
                            <Grid
                                x:Name="HdrGainPanel"
                                RowSpacing="6"
                                Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider
                                        x:Name="HdrGainSlider"
                                        AutomationProperties.AutomationId="HdrGainSlider"
                                        AutomationProperties.Name="HDR 高光目标"
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="True"
                                        LargeChange="100"
                                        Maximum="4000"
                                        Minimum="100"
                                        SmallChange="10"
                                        StepFrequency="10"
                                        Value="1000"
                                        ValueChanged="HdrGainSlider_ValueChanged" />
                                    <Button
                                        Grid.Column="1"
                                        AutomationProperties.AutomationId="ResetHdrGainToDisplayPeakButton"
                                        AutomationProperties.Name="重置为显示峰值"
                                        Click="ResetHdrGainToDisplayPeak_Click"
                                        Content="重置"
                                        ToolTipService.ToolTip="重置为当前显示器峰值" />
                                </Grid>
                                <TextBlock
                                    x:Name="HdrGainValueText"
                                    Grid.Row="1"
                                    HorizontalAlignment="Right"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="1000 nits" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <Expander
                        Header="诊断"
                        HorizontalAlignment="Stretch">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource InspectorLabelTextStyle}" Text="路径" />
                                <TextBlock Grid.Column="1" Style="{StaticResource InspectorValueTextStyle}" Text="{x:Bind ViewModel.FilePath, Mode=OneWay}" />
                                <TextBlock Grid.Row="1" Style="{StaticResource InspectorLabelTextStyle}" Text="支持" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource InspectorValueTextStyle}" Text="{x:Bind ViewModel.SupportStatus, Mode=OneWay}" />
                                <TextBlock Grid.Row="2" Style="{StaticResource InspectorLabelTextStyle}" Text="信号" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource InspectorValueTextStyle}" Text="{x:Bind ViewModel.GainMapStatus, Mode=OneWay}" />
                                <TextBlock Grid.Row="3" Style="{StaticResource InspectorLabelTextStyle}" Text="位置" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource InspectorValueTextStyle}" Text="{x:Bind ViewModel.GainMapLocation, Mode=OneWay}" />
                                <TextBlock Grid.Row="4" Style="{StaticResource InspectorLabelTextStyle}" Text="元数据" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource InspectorValueTextStyle}" Text="{x:Bind ViewModel.GainMapMetadata, Mode=OneWay}" />
                                <TextBlock Grid.Row="5" Style="{StaticResource InspectorLabelTextStyle}" Text="容器" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource InspectorValueTextStyle}" Text="{x:Bind ViewModel.JpegMetadata, Mode=OneWay}" />
                                <TextBlock Grid.Row="6" Style="{StaticResource InspectorLabelTextStyle}" Text="动态" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource InspectorValueTextStyle}" Text="{x:Bind ViewModel.CompanionMediaSummary, Mode=OneWay}" />
                                <TextBlock Grid.Row="7" Style="{StaticResource InspectorLabelTextStyle}" Text="视频HDR" />
                                <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource InspectorValueTextStyle}" Text="{x:Bind ViewModel.CompanionVideoHdrSummary, Mode=OneWay}" />
                                <TextBlock Grid.Row="8" Style="{StaticResource InspectorLabelTextStyle}" Text="视频" />
                                <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource InspectorValueTextStyle}" Text="{x:Bind ViewModel.CompanionVideoStatus, Mode=OneWay}" />
                            </Grid>
                            <TextBox
                                MinHeight="120"
                                AcceptsReturn="True"
                                AutomationProperties.AutomationId="RenderStatusTextBox"
                                AutomationProperties.Name="渲染状态"
                                Background="Transparent"
                                FontFamily="Consolas"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsReadOnly="True"
                                Text="{x:Bind ViewModel.RenderStatus, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="GamutToolsPanel" Grid.Row="1" Visibility="Collapsed"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,24,4" Spacing="16">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="色域分布" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="CIE 1931 xy · 预览颜色" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button x:Name="RefreshGamutButton" Grid.Column="1" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                                    Click="RefreshAnalysis_Click" AutomationProperties.Name="刷新色域分析" ToolTipService.ToolTip="分析当前可见画面">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                        </Grid>
                        <Border Background="{ThemeResource ControlAltFillColorSecondaryBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}">
                            <Canvas x:Name="ChromaticityCanvas" Height="288" SizeChanged="Chromaticity_SizeChanged" ActualThemeChanged="Chromaticity_ActualThemeChanged"
                                    AutomationProperties.Name="CIE 1931 xy 色度图，颜色分布、色域边界和最近取样点" />
                        </Border>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <CheckBox x:Name="SrgbBoundaryToggle" Content="sRGB" IsChecked="True" MinWidth="0"
                                      Checked="GamutBoundary_Changed" Unchecked="GamutBoundary_Changed" AutomationProperties.Name="显示 sRGB 色域边界" />
                            <CheckBox x:Name="P3BoundaryToggle" Grid.Column="1" Content="P3" IsChecked="True" MinWidth="0" Foreground="#E1AA50"
                                      Checked="GamutBoundary_Changed" Unchecked="GamutBoundary_Changed" AutomationProperties.Name="显示 Display P3 色域边界" />
                            <CheckBox x:Name="Bt2020BoundaryToggle" Grid.Column="2" Content="2020" IsChecked="True" MinWidth="0" Foreground="#57BDDA"
                                      Checked="GamutBoundary_Changed" Unchecked="GamutBoundary_Changed" AutomationProperties.Name="显示 BT.2020 色域边界" />
                        </Grid>
                        <TextBlock x:Name="GamutSummaryText" Text="打开图片后刷新分析" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <StackPanel Spacing="8">
                            <TextBlock Text="最近取样" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="ChromaticitySampleText" Text="将指针移到图片上，查看颜色位置" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock x:Name="ChromaticityGamutText" Text="十字标记为取样点，D65 为参考白点" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Content="关于色域图" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="0" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel MaxWidth="280" Spacing="12">
                                        <TextBlock TextWrapping="Wrap" Text="点云表示当前可见区域在显示映射后的颜色分布，点越亮表示像素越集中。它不代表源文件或显示器的色域覆盖率。黑色与无效颜色没有有效 xy 坐标，不计入点云。缩放、切图或改变显示参数后请刷新。背景颜色仅作示意，坐标和边界按标准计算。" />
                                        <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Text="光谱轨迹：CIE 2019，CIE 1931 标准色度观察者数据；由 380–700 nm 数据每 5 nm 换算。CC BY-SA 4.0。" />
                                        <HyperlinkButton Content="CIE 数据与来源" NavigateUri="https://doi.org/10.25039/CIE.DS.xvudnb9b" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="ViewerToolsPanel" Grid.Row="1" Visibility="Collapsed"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <!-- Reserve a gutter for WinUI overlay scrollbars, including the expanded thumb. -->
                    <StackPanel Margin="0,0,24,4" Spacing="16">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="直方图" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="当前可见区域 · 显示映射后" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button x:Name="RefreshAnalysisButton" Grid.Column="1" Click="RefreshAnalysis_Click" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                                        AutomationProperties.Name="刷新亮度分析" ToolTipService.ToolTip="刷新直方图与像素取样">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                </Button>
                            </Grid>
                            <Border Background="{ThemeResource ControlAltFillColorSecondaryBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}" Padding="8,8,8,0">
                                <Grid RowSpacing="4">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid Height="128">
                                        <Canvas x:Name="LuminanceHistogram" SizeChanged="Histogram_SizeChanged" ActualThemeChanged="Histogram_ActualThemeChanged"
                                                AutomationProperties.Name="RGB 直方图，左侧 SDR，右侧 HDR 高光" />
                                        <TextBlock x:Name="HistogramEmptyText" Text="打开图片后刷新分析" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <TextBlock Text="SDR" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                            <TextBlock Text="HDR" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                    <Grid Grid.Row="2" Padding="0,8" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="R" Foreground="#F16B70" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock Text="G" Foreground="#54BA83" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock Text="B" Foreground="#63A4ED" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                        <TextBlock x:Name="HistogramWhiteText" Text="HDR 刻度 +1 ～ +6 EV" HorizontalAlignment="Right"
                                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="平均亮度" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="AverageLuminanceText" Text="—" Style="{StaticResource SubtitleTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="峰值亮度" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="PeakLuminanceText" Text="—" Style="{StaticResource SubtitleTextBlockStyle}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="AnalysisSummary" Text="点击刷新，分析当前画面" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <StackPanel Spacing="12">
                            <Grid>
                                <TextBlock Text="画面辅助" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Button x:Name="ResetViewerToolsButton" HorizontalAlignment="Right" Width="28" Height="28" Padding="0"
                                        Background="Transparent" BorderThickness="0" IsEnabled="False" Click="ResetViewerTools_Click"
                                        AutomationProperties.Name="关闭画面辅助" ToolTipService.ToolTip="关闭辅助，恢复原图显示">
                                    <FontIcon Glyph="&#xE777;" FontSize="12" />
                                </Button>
                            </Grid>
                            <ToggleButton x:Name="ComparisonToggle" HorizontalAlignment="Stretch" MinHeight="36" Padding="8,4"
                                          AutomationProperties.Name="HDR SDR 分屏" ToolTipService.ToolTip="左侧 SDR，右侧 HDR；拖动图片分界线调整比例"
                                          Checked="ViewerToolSetting_Click" Unchecked="ViewerToolSetting_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE745;" FontSize="14" />
                                    <TextBlock Text="分屏对比" />
                                </StackPanel>
                            </ToggleButton>
                            <StackPanel x:Name="ComparisonControls" Visibility="Collapsed" Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ComparisonPositionText" Text="SDR 50% · HDR 50%" VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button Grid.Column="1" Content="居中" Padding="8,4" Background="Transparent" BorderThickness="0"
                                            Click="CenterComparison_Click" AutomationProperties.Name="分界线居中" ToolTipService.ToolTip="恢复 50 / 50 对比" />
                                </Grid>
                                <Slider x:Name="ComparisonSlider" Minimum="0" Maximum="100" Value="50" StepFrequency="1"
                                        AutomationProperties.Name="SDR 分界线位置" ValueChanged="ComparisonSlider_ValueChanged" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="像素取样" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Border Padding="12" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="{StaticResource ControlCornerRadius}">
                                <TextBlock x:Name="PixelSampleText" Text="刷新后，将指针移到图片上" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}" IsTextSelectionEnabled="True" />
                            </Border>
                        </StackPanel>
                        <Button Content="关于分析数值" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="0" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">
                            <Button.Flyout>
                                <Flyout>
                                    <TextBlock MaxWidth="280" TextWrapping="Wrap" Text="RGB 曲线来自显示映射后的 scRGB 预览。左半区为 SDR（sRGB 编码刻度），中线为当前 SDR 白点；右半区每条虚线增加一档曝光，最右端收纳 +6 EV 及以上值。三通道共用纵轴，按像素数量的平方根显示，以保留小峰。负通道值归入最左端。下方亮度读数为 RGB 加权亮度，非屏幕实测。分析不包含分界线。缩放、切图或调整显示参数后，需要刷新。分屏右侧使用自适应 HDR。" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid
            x:Name="ExportProgressOverlay"
            Background="{ThemeResource SmokeFillColorDefaultBrush}"
            Canvas.ZIndex="20"
            Visibility="Collapsed">
            <Border
                Width="420"
                MaxWidth="420"
                Padding="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
                BackgroundSizing="InnerBorderEdge"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing
                            x:Name="ExportProgressRing"
                            Width="32"
                            Height="32"
                            IsActive="False" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock
                                x:Name="ExportProgressTitleText"
                                FontWeight="SemiBold"
                                Text="正在导出" />
                            <TextBlock
                                x:Name="ExportProgressDetailText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="正在准备文件"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar
                        x:Name="ExportProgressBar"
                        IsIndeterminate="True" />
                    <Button x:Name="CancelExportButton"
                            Content="取消导出"
                            HorizontalAlignment="Right"
                            AutomationProperties.AutomationId="CancelExportButton"
                            AutomationProperties.Name="取消导出"
                            Click="CancelExport_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
