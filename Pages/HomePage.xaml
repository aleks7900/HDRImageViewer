<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HdrImageViewer.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:HdrImageViewer.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:presentation="using:HdrImageViewer.Presentation"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop"
    KeyDown="Page_KeyDown"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Page.Resources>
        <AcrylicBrush
            x:Key="ViewerChromeAcrylicBrush"
            FallbackColor="{ThemeResource SystemChromeLowColor}"
            TintColor="{ThemeResource SystemChromeLowColor}"
            TintLuminosityOpacity="0.88"
            TintOpacity="0.58" />
        <Style
            x:Key="InspectorLabelTextStyle"
            BasedOn="{StaticResource BodyTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style
            x:Key="InspectorValueTextStyle"
            BasedOn="{StaticResource BodyTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style
            x:Key="PhotoToolbarButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="PhotoToolbarToggleButtonStyle"
            BasedOn="{StaticResource DefaultToggleButtonStyle}"
            TargetType="ToggleButton">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="DeleteConfirmationButtonStyle"
            BasedOn="{StaticResource AccentButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
        <Style
            x:Key="LivePhotoOverlayButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="LivePhotoOverlayToggleButtonStyle"
            BasedOn="{StaticResource DefaultToggleButtonStyle}"
            TargetType="ToggleButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="SideNavigationButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="64" />
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{ThemeResource ViewerChromeAcrylicBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="FilmstripListViewItemStyle"
            TargetType="ListViewItem">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="46" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Grid
        x:Name="HomeRoot"
        SizeChanged="HomeRoot_SizeChanged">
        <Grid
            ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PreviewColumn" Width="*" MinWidth="360" />
                <ColumnDefinition x:Name="InspectorColumn" Width="352" />
            </Grid.ColumnDefinitions>

            <Grid
                x:Name="PreviewSurface"
                Background="Transparent"
                ManipulationDelta="PreviewSurface_ManipulationDelta"
                ManipulationMode="Scale"
                PointerCaptureLost="PreviewSurface_PointerCaptureLost"
                PointerMoved="PreviewSurface_PointerMoved"
                PointerPressed="PreviewSurface_PointerPressed"
                PointerReleased="PreviewSurface_PointerReleased"
                PointerWheelChanged="PreviewSurface_PointerWheelChanged"
                SizeChanged="PreviewSurface_SizeChanged">
                <SwapChainPanel
                    x:Name="HdrSwapChainHost"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    AutomationProperties.Name="HDR 渲染表面"
                    CompositionScaleChanged="HdrSwapChainHost_CompositionScaleChanged"
                    IsHitTestVisible="False"
                    RenderTransformOrigin="0.5,0.5"
                    SizeChanged="HdrSwapChainHost_SizeChanged"
                    Visibility="Collapsed">
                    <SwapChainPanel.RenderTransform>
                        <ScaleTransform x:Name="SwapChainZoomPreviewTransform" />
                    </SwapChainPanel.RenderTransform>
                </SwapChainPanel>
                <ScrollViewer
                        x:Name="ImageScroller"
                    Background="Transparent"
                    AutomationProperties.Name="图片画布"
                    HorizontalScrollBarVisibility="Hidden"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Hidden"
                    ViewChanged="ImageScroller_ViewChanged"
                    ZoomMode="Disabled">
                    <Grid
                        x:Name="ImageViewport"
                        Background="Transparent">
                        <Grid
                            x:Name="ImageSurface"
                            Background="Transparent"
                            HorizontalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        x:Name="SaveAsMenuItem"
                                        AutomationProperties.AutomationId="SaveAsMenuItem"
                                        Click="SaveAsMenuItem_Click"
                                        IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}"
                                        KeyboardAcceleratorTextOverride="Ctrl+S"
                                        Text="另存为">
                                        <MenuFlyoutItem.Icon>
                                            <SymbolIcon Symbol="Save" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        x:Name="CopyImageMenuItem"
                                        AutomationProperties.AutomationId="CopyImageMenuItem"
                                        Click="CopyImageMenuItem_Click"
                                        IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}"
                                        KeyboardAcceleratorTextOverride="Ctrl+C"
                                        Text="复制">
                                        <MenuFlyoutItem.Icon>
                                            <SymbolIcon Symbol="Copy" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        x:Name="CopyPathMenuItem"
                                        AutomationProperties.AutomationId="CopyPathMenuItem"
                                        Click="CopyPathMenuItem_Click"
                                        IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}"
                                        KeyboardAcceleratorTextOverride="Ctrl+Shift+C"
                                        Text="复制为路径">
                                        <MenuFlyoutItem.Icon>
                                            <SymbolIcon Symbol="Document" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        x:Name="FileInfoMenuItem"
                                        AutomationProperties.AutomationId="FileInfoMenuItem"
                                        Click="FileInfoMenuItem_Click"
                                        IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}"
                                        KeyboardAcceleratorTextOverride="Alt+Enter"
                                        Text="文件信息">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE946;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        x:Name="DeleteImageMenuItem"
                                        AutomationProperties.AutomationId="DeleteImageMenuItem"
                                        Click="DeleteImageMenuItem_Click"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}"
                                        KeyboardAcceleratorTextOverride="Delete"
                                        Text="删除">
                                        <MenuFlyoutItem.Icon>
                                            <SymbolIcon Symbol="Delete" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="ImageInteractionScaleTransform" />
                            </Grid.RenderTransform>
                            <Image
                        x:Name="FallbackImage"
                        AutomationProperties.Name="图片预览回退层"
                                Stretch="Uniform"
                                Visibility="Collapsed" />
                            <MediaPlayerElement
                                x:Name="LivePhotoPlayer"
                                AreTransportControlsEnabled="False"
                                AutoPlay="False"
                                Canvas.ZIndex="4"
                                Stretch="Fill"
                                Visibility="Collapsed" />
                            <Border
                                x:Name="LivePhotoOverlay"
                                Margin="16"
                                Padding="4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{ThemeResource ViewerChromeAcrylicBrush}"
                                BackgroundSizing="InnerBorderEdge"
                                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Canvas.ZIndex="5"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                Visibility="{x:Bind local:HomePage.BoolToVisibility(ViewModel.HasCompanionMedia), Mode=OneWay}">
                                <Grid ColumnSpacing="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        x:Name="LivePhotoButton"
                                        AutomationProperties.AutomationId="LivePhotoButton"
                                        AutomationProperties.Name="播放动态照片"
                                        Click="LivePhotoButton_Click"
                                        Style="{StaticResource LivePhotoOverlayButtonStyle}"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.CompanionMediaSummary, Mode=OneWay}">
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="7">
                                            <Grid
                                                Width="18"
                                                Height="18"
                                                VerticalAlignment="Center">
                                                <Ellipse
                                                    Width="16"
                                                    Height="16"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Opacity="0.9"
                                                    Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                                    StrokeDashArray="1,1.8"
                                                    StrokeThickness="1.4" />
                                                <Ellipse
                                                    Width="8"
                                                    Height="8"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Opacity="0.7"
                                                    Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                                    StrokeThickness="1.2" />
                                                <Ellipse
                                                    Width="3"
                                                    Height="3"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                                            </Grid>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Text="{x:Bind ViewModel.CompanionMediaLabel, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                    <Border
                                        Grid.Column="1"
                                        Width="1"
                                        Height="18"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                        Opacity="0.7" />
                                    <ToggleButton
                                        x:Name="LivePhotoMuteToggle"
                                        Grid.Column="2"
                                        AutomationProperties.AutomationId="LivePhotoMuteToggle"
                                        AutomationProperties.Name="动态照片静音"
                                        Click="LivePhotoMuteToggle_Click"
                                        IsChecked="{x:Bind ViewModel.IsCompanionMediaMuted, Mode=TwoWay}"
                                        Style="{StaticResource LivePhotoOverlayToggleButtonStyle}"
                                        ToolTipService.ToolTip="动态照片静音">
                                        <FontIcon
                                            FontSize="14"
                                            Glyph="{x:Bind local:HomePage.CompanionMuteGlyph(ViewModel.IsCompanionMediaMuted), Mode=OneWay}" />
                                    </ToggleButton>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
                <StackPanel
                    HorizontalAlignment="Center"
                    IsHitTestVisible="False"
                    Opacity="{x:Bind ViewModel.PlaceholderOpacity, Mode=OneWay}"
                    VerticalAlignment="Center"
                    Spacing="8">
                    <FontIcon
                        FontSize="40"
                        Glyph="&#xEB9F;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.FileName, Mode=OneWay}" />
                    <TextBlock
                        MaxWidth="420"
                        HorizontalAlignment="Center"
                        Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
                <Border x:Name="ComparisonDivider" Width="32" HorizontalAlignment="Left"
                        Background="Transparent" Visibility="Collapsed"
                        ToolTipService.ToolTip="拖动分界线 · 双击居中" DoubleTapped="ComparisonDivider_DoubleTapped"
                        PointerPressed="ComparisonDivider_PointerPressed"
                        PointerMoved="ComparisonDivider_PointerMoved"
                        PointerReleased="ComparisonDivider_PointerReleased"
                        PointerCaptureLost="ComparisonDivider_PointerCaptureLost">
                    <Grid>
                        <Border Width="3" Background="#66000000" HorizontalAlignment="Center" />
                        <Border Width="1" Background="#E6FFFFFF" HorizontalAlignment="Center" />
                        <Canvas IsHitTestVisible="False">
                            <Border x:Name="ComparisonSdrBadge" Canvas.Left="-40" Canvas.Top="12" Padding="8,4" Background="#CC202124" CornerRadius="4">
                                <TextBlock Text="SDR" Foreground="White" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Border>
                            <Border x:Name="ComparisonHdrBadge" Canvas.Left="32" Canvas.Top="12" Padding="8,4" Background="#CC202124" CornerRadius="4">
                                <TextBlock Text="HDR" Foreground="White" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Border>
                        </Canvas>
                        <Border Background="#F0202124" BorderBrush="#D9FFFFFF" BorderThickness="1" Height="32" VerticalAlignment="Center" CornerRadius="16">
                            <Grid ColumnSpacing="4" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE76B;" FontSize="10" Foreground="White" />
                                <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="10" Foreground="White" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <Button
                    x:Name="SidePreviousImageButton"
                    Margin="20,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="SidePreviousImageButton"
                    AutomationProperties.Name="上一张"
                    Click="PreviousImage_Click"
                    Style="{StaticResource SideNavigationButtonStyle}"
                    ToolTipService.ToolTip="上一张">
                    <FontIcon
                        FontSize="20"
                        Glyph="&#xE76B;" />
                </Button>
                <Button
                    x:Name="SideNextImageButton"
                    Margin="0,0,20,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="SideNextImageButton"
                    AutomationProperties.Name="下一张"
                    Click="NextImage_Click"
                    Style="{StaticResource SideNavigationButtonStyle}"
                    ToolTipService.ToolTip="下一张">
                    <FontIcon
                        FontSize="20"
                        Glyph="&#xE76C;" />
                </Button>
                <StackPanel
                    x:Name="TopActionBar"
                    Margin="0,18,18,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button Click="BatchExport_Click" Style="{StaticResource PhotoToolbarButtonStyle}"
                            AutomationProperties.AutomationId="BatchExportButton" AutomationProperties.Name="批量导出"
                            ToolTipService.ToolTip="批量导出">
                        <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                    </Button>
                    <Button Click="ViewerTools_Click" Style="{StaticResource PhotoToolbarButtonStyle}"
                            AutomationProperties.AutomationId="ViewerToolsButton" AutomationProperties.Name="亮度分析"
                            ToolTipService.ToolTip="亮度分析与 HDR 对比">
                        <FontIcon Glyph="&#xE9D9;" FontSize="16" />
                    </Button>
                    <ToggleButton
                        x:Name="TopInspectorToggleButton"
                        AutomationProperties.AutomationId="TopInspectorToggleButton"
                        AutomationProperties.Name="切换详情栏"
                        Click="TopInspectorToggleButton_Click"
                        Style="{StaticResource PhotoToolbarToggleButtonStyle}"
                        ToolTipService.ToolTip="隐藏详情栏 (I)">
                        <FontIcon
                            FontSize="16"
                            Glyph="&#xE946;" />
                    </ToggleButton>
                    <Button
                        x:Name="TopCropButton"
                        AutomationProperties.AutomationId="TopCropButton"
                        AutomationProperties.Name="裁切"
                        Click="CropButton_Click"
                        Style="{StaticResource PhotoToolbarButtonStyle}"
                        ToolTipService.ToolTip="裁切">
                        <FontIcon
                            FontSize="16"
                            Glyph="&#xE7A8;" />
                    </Button>
                    <Button
                        x:Name="TopFullScreenButton"
                        AutomationProperties.AutomationId="TopFullScreenButton"
                        AutomationProperties.Name="全屏"
                        Click="FullScreen_Click"
                        Style="{StaticResource PhotoToolbarButtonStyle}"
                        ToolTipService.ToolTip="全屏">
                        <FontIcon
                            x:Name="TopFullScreenIcon"
                            FontSize="16"
                            Glyph="&#xE740;" />
                    </Button>
                </StackPanel>
                <Grid
                    x:Name="CropOverlay"
                    Background="{ThemeResource SmokeFillColorDefaultBrush}"
                    IsHitTestVisible="True"
                    Visibility="Collapsed">
                    <Border
                        x:Name="CropFrame"
                        Width="520"
                        Height="340"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderBrush="{ThemeResource ControlStrokeColorForStrongFillWhenOnImageBrush}"
                        BorderThickness="2"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        PointerMoved="CropFrame_PointerMoved"
                        PointerPressed="CropFrame_PointerPressed"
                        PointerReleased="CropFrame_PointerReleased">
                        <Grid Background="Transparent">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border
                                    Grid.Row="1"
                                    Height="1"
                                    Background="{ThemeResource ControlStrokeColorForStrongFillWhenOnImageBrush}" />
                                <Border
                                    Grid.Row="2"
                                    Height="1"
                                    Background="{ThemeResource ControlStrokeColorForStrongFillWhenOnImageBrush}" />
                            </Grid>
                            <Grid ColumnSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Grid.Column="1"
                                    Width="1"
                                    Background="{ThemeResource ControlStrokeColorForStrongFillWhenOnImageBrush}" />
                                <Border
                                    Grid.Column="2"
                                    Width="1"
                                    Background="{ThemeResource ControlStrokeColorForStrongFillWhenOnImageBrush}" />
                            </Grid>
                            <Grid
                                Width="24"
                                Height="24"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False">
                                <Border
                                    Width="24"
                                    Height="4"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}" />
                                <Border
                                    Width="4"
                                    Height="24"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}" />
                            </Grid>
                            <Grid
                                Width="24"
                                Height="24"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False">
                                <Border
                                    Width="24"
                                    Height="4"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}" />
                                <Border
                                    Width="4"
                                    Height="24"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}" />
                            </Grid>
                            <Grid
                                Width="24"
                                Height="24"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                IsHitTestVisible="False">
                                <Border
                                    Width="24"
                                    Height="4"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}" />
                                <Border
                                    Width="4"
                                    Height="24"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}" />
                            </Grid>
                            <Grid
                                Width="24"
                                Height="24"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                IsHitTestVisible="False">
                                <Border
                                    Width="24"
                                    Height="4"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}" />
                                <Border
                                    Width="4"
                                    Height="24"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}" />
                            </Grid>
                            <Thumb
                                x:Name="CropTopThumb"
                                Height="20"
                                Margin="32,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                AutomationProperties.AutomationId="CropTopThumb"
                                AutomationProperties.Name="调整上边裁切线"
                                Background="Transparent"
                                DragDelta="CropResizeThumb_DragDelta"
                                Tag="Top" />
                            <Thumb
                                x:Name="CropBottomThumb"
                                Height="20"
                                Margin="32,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom"
                                AutomationProperties.AutomationId="CropBottomThumb"
                                AutomationProperties.Name="调整下边裁切线"
                                Background="Transparent"
                                DragDelta="CropResizeThumb_DragDelta"
                                Tag="Bottom" />
                            <Thumb
                                x:Name="CropLeftThumb"
                                Width="20"
                                Margin="0,32"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                AutomationProperties.AutomationId="CropLeftThumb"
                                AutomationProperties.Name="调整左边裁切线"
                                Background="Transparent"
                                DragDelta="CropResizeThumb_DragDelta"
                                Tag="Left" />
                            <Thumb
                                x:Name="CropRightThumb"
                                Width="20"
                                Margin="0,32"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Stretch"
                                AutomationProperties.AutomationId="CropRightThumb"
                                AutomationProperties.Name="调整右边裁切线"
                                Background="Transparent"
                                DragDelta="CropResizeThumb_DragDelta"
                                Tag="Right" />
                            <Thumb
                                x:Name="CropTopLeftThumb"
                                Width="36"
                                Height="36"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                AutomationProperties.AutomationId="CropTopLeftThumb"
                                AutomationProperties.Name="调整左上裁切角"
                                Background="Transparent"
                                DragDelta="CropResizeThumb_DragDelta"
                                Tag="TopLeft" />
                            <Thumb
                                x:Name="CropTopRightThumb"
                                Width="36"
                                Height="36"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                AutomationProperties.AutomationId="CropTopRightThumb"
                                AutomationProperties.Name="调整右上裁切角"
                                Background="Transparent"
                                DragDelta="CropResizeThumb_DragDelta"
                                Tag="TopRight" />
                            <Thumb
                                x:Name="CropBottomLeftThumb"
                                Width="36"
                                Height="36"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                AutomationProperties.AutomationId="CropBottomLeftThumb"
                                AutomationProperties.Name="调整左下裁切角"
                                Background="Transparent"
                                DragDelta="CropResizeThumb_DragDelta"
                                Tag="BottomLeft" />
                            <Thumb
